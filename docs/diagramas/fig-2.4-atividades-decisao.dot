digraph atividades {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=12, nodesep=0.45, ranksep=0.32, bgcolor="white", pad=0.3, splines=spline];
  node  [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#37474F", penwidth=1.2, margin="0.16,0.06"];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#37474F", penwidth=1.1, arrowsize=0.75];

  inicio [shape=circle, label="", width=0.25, style=filled, fillcolor="#263238"];
  f200 [shape=doublecircle, label="", width=0.18, style=filled, fillcolor="#263238"];
  f403 [shape=doublecircle, label="", width=0.18, style=filled, fillcolor="#263238"];
  f400 [shape=doublecircle, label="", width=0.18, style=filled, fillcolor="#263238"];
  f429 [shape=doublecircle, label="", width=0.18, style=filled, fillcolor="#263238"];
  f401 [shape=doublecircle, label="", width=0.18, style=filled, fillcolor="#263238"];

  receber  [label=<Receber POST /api/auth/login<BR/>com o cookie da sessão e o cabeçalho X-XSRF-TOKEN<BR/><FONT POINT-SIZE="8" COLOR="#546E7A">cadeia de filtros do Spring Security</FONT>>];
  dcsrf    [shape=diamond, label="token CSRF\nconfere com\no da sessão?", fontsize=9, fillcolor="#FFFDE7", margin="0.04,0.04"];
  r403     [label=<Responder <B>403 Forbidden</B><BR/>{"erro": "ACESSO_NEGADO"}>, fillcolor="#FFF3E0", color="#E65100"];
  converter[label=<Converter o JSON em LoginRequest<BR/>e normalizar o e-mail (trim, minúsculas)<BR/><FONT POINT-SIZE="8" COLOR="#546E7A">DispatcherServlet + construtor do record</FONT>>];
  dval     [shape=diamond, label="formato\nválido?", fontsize=9, fillcolor="#FFFDE7", margin="0.04,0.04"];
  r400     [label=<Responder <B>400 Bad Request</B><BR/>{"erro": "ENTRADA_INVALIDA"}<BR/><FONT POINT-SIZE="8" COLOR="#546E7A">AuthExceptionHandler</FONT>>, fillcolor="#FFF3E0", color="#E65100"];
  dlim     [shape=diamond, label="IP ou e-mail\nacima do limite\nna janela?", fontsize=9, fillcolor="#FFFDE7", margin="0.04,0.04"];
  r429     [label=<Responder <B>429 Too Many Requests</B><BR/>+ Retry-After · {"erro": "TENTATIVAS_EXCEDIDAS"}<BR/><FONT POINT-SIZE="8" COLOR="#546E7A">AuthController + LimitadorTentativasLogin</FONT>>, fillcolor="#FFF3E0", color="#E65100"];

  buscar   [label=<Buscar usuário pelo e-mail<BR/><FONT POINT-SIZE="8" COLOR="#546E7A">UserRepository → JpaUserRepository → PostgreSQL</FONT>>];
  verificar[label=<Executar verificar(senha, hash) uma única vez:<BR/>hash armazenado, se o usuário existe;<BR/><I>hashFicticio</I>, caso contrário<BR/><FONT POINT-SIZE="8" COLOR="#546E7A">AuthService + Argon2PasswordHasher</FONT>>, fillcolor="#ECEFF1"];
  dok      [shape=diamond, label="usuário existe\ne senha confere?", fontsize=9, fillcolor="#FFFDE7", margin="0.04,0.04"];
  log1     [label=<Registrar tentativa SUCESSO<BR/>e zerar o contador do e-mail>, fillcolor="#ECEFF1"];
  sessao   [label=<Trocar o identificador da sessão e<BR/>gravar o usuário autenticado na sessão<BR/><FONT POINT-SIZE="8" COLOR="#546E7A">AuthController + SecurityContextRepository</FONT>>];
  log2     [label=<Registrar tentativa FALHA e<BR/>somar uma falha ao IP e ao e-mail>, fillcolor="#ECEFF1"];
  r200     [label=<Responder <B>200 OK</B> + cookie JSESSIONID<BR/>{"autenticado": true, "usuario": {id, nome, email}}>, fillcolor="#E8F5E9", color="#2E7D32"];
  r401     [label=<Responder <B>401 Unauthorized</B> + WWW-Authenticate<BR/>{"autenticado": false, "erro": "CREDENCIAIS_INVALIDAS"}>, fillcolor="#FFEBEE", color="#C62828"];

  inicio -> receber -> dcsrf;
  dcsrf -> r403 [label=" [não]"]; r403 -> f403;
  dcsrf -> converter [label=" [sim]"];
  converter -> dval;
  dval -> r400 [label=" [não]"]; r400 -> f400;
  dval -> dlim [label=" [sim]"];
  dlim -> r429 [label=" [sim]"]; r429 -> f429;
  dlim -> buscar [label=" [não]"];
  buscar -> verificar -> dok;
  dok -> log1 [label=" [sim]"]; dok -> log2 [label=" [não]"];
  log1 -> sessao -> r200 -> f200;
  log2 -> r401 -> f401;
  { rank=same; dcsrf; r403; }
  { rank=same; dval; r400; }
  { rank=same; dlim; r429; }
  { rank=same; log1; log2; }
}
