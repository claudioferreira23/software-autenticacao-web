digraph componentes {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, nodesep=0.45, ranksep=0.5,
         bgcolor="white", pad=0.3, newrank=true, splines=spline];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled",
         fillcolor="#FFFFFF", color="#37474F", penwidth=1.2, margin="0.18,0.08"];
  edge  [fontname="DejaVu Sans", fontsize=9.5, color="#37474F", penwidth=1.1, arrowsize=0.8];

  subgraph cluster_cliente {
    label=<<B>Camada de Apresentação</B> — navegador Web executando a SPA Angular>;
    labeljust=l; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1565C0"; penwidth=1.4;
    nav     [label=<<FONT POINT-SIZE="9">«runtime»</FONT><BR/><B>Motor do navegador</B><BR/><FONT POINT-SIZE="9">executa a SPA e aplica a política CORS</FONT>>, fillcolor="#F5F5F5"];
    login   [label=<<FONT POINT-SIZE="9">«component»</FONT><BR/><B>LoginComponent</B><BR/><FONT POINT-SIZE="9">formulário e resultado</FONT>>];
    svc     [label=<<FONT POINT-SIZE="9">«service»</FONT><BR/><B>LoginService</B><BR/><FONT POINT-SIZE="9">monta a requisição</FONT>>];
    http    [label=<<FONT POINT-SIZE="9">«framework»</FONT><BR/><B>HttpClient</B>>, fillcolor="#F5F5F5"];
    { rank=same; nav; login; svc; http; }
    nav -> login [label=" executa", style=dotted];
    login -> svc [label=" «use»\n login()", style=dashed, arrowhead=vee];
    svc -> http  [label=" «use»\n post()", style=dashed, arrowhead=vee];
  }

  subgraph cluster_web {
    label=<<B>Servidor Web</B> — Angular CLI (ng serve), porta 4200>;
    labeljust=l; style="rounded,filled"; fillcolor="#FFF8E1"; color="#F9A825"; penwidth=1.4;
    estaticos [label=<<B>Entrega de recursos estáticos</B><BR/><FONT POINT-SIZE="9">index.html, *.js, *.css</FONT>>];
  }

  subgraph cluster_app {
    label=<<B>Servidor de Aplicação</B> — Spring Boot 4 com Tomcat embutido, porta 8080>;
    labeljust=l; style="rounded,filled"; fillcolor="#E8F5E9"; color="#2E7D32"; penwidth=1.4;

    subgraph cluster_api {
      label=<<I>api</I> — controle>; labeljust=l; style="dashed,rounded,filled"; color="#66BB6A"; fillcolor="#F1F8E9";
      dispatcher [label=<<FONT POINT-SIZE="9">«framework»</FONT><BR/><B>DispatcherServlet</B><BR/><FONT POINT-SIZE="9">+ CorsConfig</FONT>>, fillcolor="#F5F5F5"];
      controller [label=<<FONT POINT-SIZE="9">«controller»</FONT><BR/><B>AuthController</B><BR/><FONT POINT-SIZE="9">POST /api/auth/login</FONT>>];
      handler    [label=<<FONT POINT-SIZE="9">«controller advice»</FONT><BR/><B>AuthExceptionHandler</B><BR/><FONT POINT-SIZE="9">respostas 400 e 500</FONT>>];
      { rank=same; dispatcher; controller; handler; }
      handler -> dispatcher [style=invis]; dispatcher -> controller [style=invis];
    }
    subgraph cluster_dom {
      label=<<I>domain</I> — negócio (sem dependência de framework)>; labeljust=l; style="dashed,rounded,filled"; color="#66BB6A"; fillcolor="#F1F8E9";
      service [label=<<FONT POINT-SIZE="9">«service»</FONT><BR/><B>AuthService</B><BR/><FONT POINT-SIZE="9">decisão de autenticação</FONT>>];
      repoi   [label=<<FONT POINT-SIZE="9">«interface»</FONT><BR/><B>UserRepository</B>>];
      hasheri [label=<<FONT POINT-SIZE="9">«interface»</FONT><BR/><B>PasswordHasher</B>>];
      { rank=same; repoi; service; hasheri; }
      repoi -> service [style=invis]; service -> hasheri [style=invis];
    }
    subgraph cluster_inf {
      label=<<I>infra</I> — persistência e criptografia>; labeljust=l; style="dashed,rounded,filled"; color="#66BB6A"; fillcolor="#F1F8E9";
      repo   [label=<<FONT POINT-SIZE="9">«repository»</FONT><BR/><B>JpaUserRepository</B><BR/><FONT POINT-SIZE="9">usa UsuarioJpaRepository (Spring Data JPA)</FONT>>];
      hasher [label=<<FONT POINT-SIZE="9">«component»</FONT><BR/><B>Argon2PasswordHasher</B><BR/><FONT POINT-SIZE="9">Argon2PasswordEncoder (spring-security-crypto)</FONT>>];
      jdbc   [label=<<FONT POINT-SIZE="9">«driver»</FONT><BR/><B>PostgreSQL JDBC</B><BR/><FONT POINT-SIZE="9">+ Flyway (migrações)</FONT>>, fillcolor="#F5F5F5"];
      { rank=same; repo; hasher; }
    }
    dispatcher -> controller [label=" «use»\n login(LoginRequest)", style=dashed, arrowhead=vee, constraint=false];
    dispatcher -> handler    [label=" «use»\n trata exceções", style=dashed, arrowhead=vee, constraint=false];
    controller -> service    [label=" «use»\n autenticar()", style=dashed, arrowhead=vee];
    service -> repoi         [label=" «use»", style=dashed, arrowhead=vee, constraint=false];
    service -> hasheri       [label=" «use»", style=dashed, arrowhead=vee, constraint=false];
    repoi -> repo   [label=" «realize»", style=dashed, dir=back, arrowtail=onormal];
    hasheri -> hasher [label=" «realize»", style=dashed, dir=back, arrowtail=onormal];
    repo -> jdbc    [label=" «use»", style=dashed, arrowhead=vee];
  }

  subgraph cluster_db {
    label=<<B>Repositório de Dados</B> — PostgreSQL 16 em contêiner Docker, porta 5432>;
    labeljust=l; style="rounded,filled"; fillcolor="#F3E5F5"; color="#6A1B9A"; penwidth=1.4;
    tabela [label=<<B>tabela usuarios</B><BR/><FONT POINT-SIZE="9">id · nome · email · senha_hash</FONT>>, shape=cylinder, style="filled", fillcolor="#FFFFFF"];
  }

  nav -> estaticos   [label=" GET (carga inicial)", style=dotted];
  http -> dispatcher [label=<  <B>POST /api/auth/login</B> (JSON)<BR/>  precedido de OPTIONS (pré-verificação CORS)>, color="#1565C0", penwidth=1.7];
  jdbc -> tabela     [label=" SQL via TCP", color="#6A1B9A", penwidth=1.7];
}
