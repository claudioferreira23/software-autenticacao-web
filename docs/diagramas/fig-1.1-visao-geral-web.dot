// Figura 1.1 — Visão geral do funcionamento de uma aplicação Web (item 1.1)
digraph visao {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=12, nodesep=0.35, ranksep=0.6,
         bgcolor="white", pad=0.3, newrank=true, splines=spline];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled",
         fillcolor="#FFFFFF", color="#37474F", penwidth=1.2, margin="0.22,0.12"];
  edge  [fontname="DejaVu Sans", fontsize=9.5, color="#37474F", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_cli {
    label=<<B>Lado cliente</B>>; labeljust=l; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1565C0"; penwidth=1.4;
    nav [label=<<B>Navegador Web</B><BR/><FONT POINT-SIZE="9">acionado pelo usuário</FONT><BR/><FONT POINT-SIZE="9">interpreta HTML, CSS e JavaScript;<BR/>executa a interface (SPA)</FONT>>];
  }

  rede [label=<<B>Rede</B><BR/><FONT POINT-SIZE="9">TCP/IP · DNS · TLS</FONT>>, shape=ellipse, fillcolor="#ECEFF1"];

  subgraph cluster_srv {
    label=<<B>Lado servidor</B>>; labeljust=l; style="rounded,filled"; fillcolor="#F1F8E9"; color="#2E7D32"; penwidth=1.4;
    web [label=<<B>Servidor Web</B><BR/><FONT POINT-SIZE="9">entrega conteúdo estático</FONT>>, fillcolor="#FFF8E1"];
    app [label=<<B>Servidor de Aplicação</B><BR/><FONT POINT-SIZE="9">gera conteúdo dinâmico<BR/>(regras de negócio)</FONT>>, fillcolor="#E8F5E9"];
    bd  [label=<<B>SGBD</B><BR/><FONT POINT-SIZE="9">dados persistentes</FONT>>, shape=cylinder, fillcolor="#F3E5F5"];
    { rank=same; web; app; }
  }

  nav -> rede [dir=both, label=<  <B>requisição HTTP</B> →<BR/>  método · URI · cabeçalhos · corpo<BR/>  ← <B>resposta HTTP</B><BR/>  código de status · cabeçalhos · corpo>, color="#1565C0", arrowtail=vee];
  rede -> web [dir=both, arrowtail=vee, label=<  <B>(a)</B> carga da interface<BR/>  HTML, CSS, JavaScript>, color="#F9A825"];
  rede -> app [dir=both, arrowtail=vee, label=<  <B>(b)</B> chamadas à API<BR/>  dados em JSON>, color="#2E7D32"];
  app -> bd [dir=both, arrowtail=vee, label=" SQL", color="#6A1B9A"];
}
