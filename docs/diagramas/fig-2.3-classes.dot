digraph classes {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=12, nodesep=0.3, ranksep=0.5, bgcolor="white", pad=0.3, newrank=true, splines=spline];
  node  [fontname="DejaVu Sans", fontsize=9.5, shape=plain];
  edge  [fontname="DejaVu Sans", fontsize=8.5, color="#37474F", penwidth=1.0, arrowsize=0.75];
  subgraph cluster_front {
    label=<<B>frontend</B> — Angular (TypeScript)>; labeljust=l; style="rounded,filled"; fillcolor="#E3F2FD"; color="#1565C0"; penwidth=1.3;
  LoginComponent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«component»</FONT><BR/><B>LoginComponent</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- loginForm: FormGroup<BR/>- isSubmitting: signal&lt;boolean&gt;</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ submit(): void<BR/>+ navigateToRegister(): void</TD></TR></TABLE>>];
  SignUpComponent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«component»</FONT><BR/><B>SignUpComponent</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- signupForm: FormGroup<BR/>  {senhas iguais, 8 a 128 caracteres}</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ submit(): void</TD></TR></TABLE>>];
  ProfileComponent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«component»</FONT><BR/><B>ProfileComponent</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- user: Signal&lt;UsuarioResponse | null&gt;</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ logout(): void</TD></TR></TABLE>>];
  FrontAuthService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«injectable»</FONT><BR/><B>AuthService (Angular)</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- currentUserState: signal&lt;UsuarioResponse | null&gt;<BR/>+ currentUser, isAuthenticated (somente leitura)</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ initialize(): Observable&lt;UsuarioResponse | null&gt;<BR/>+ login(email, senha): Observable&lt;LoginSuccessResponse&gt;<BR/>+ register(nome, email, senha): Observable&lt;UsuarioResponse&gt;<BR/>+ logout(): Observable&lt;void&gt;<BR/>- getCsrfRequestOptions()  {GET /api/auth/csrf}</TD></TR></TABLE>>];
  Guards [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«function» CanActivateFn</FONT><BR/><B>authGuard · guestGuard</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">authGuard: exige sessão (/perfil)<BR/>guestGuard: exige visitante (/login, /cadastro)</TD></TR></TABLE>>];
    { rank=same; Guards; LoginComponent; SignUpComponent; ProfileComponent; }
  }
  subgraph cluster_back {
    label=<<B>backend</B> — br.ufg.autenticacao (Java 21 / Spring Boot)>; labeljust=l; style="rounded,filled"; fillcolor="#E8F5E9"; color="#2E7D32"; penwidth=1.3;
  subgraph cluster_api {
    label=<<I>api</I> — controle>; labeljust=l; style="rounded,filled"; fillcolor="#F1F8E9"; color="#66BB6A"; penwidth=1.3;
  AuthController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@RestController» /api/auth</FONT><BR/><B>AuthController</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- authService: AuthService<BR/>- securityContextRepository<BR/>- limitadorTentativasLogin</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ login(req: LoginRequest): ResponseEntity&lt;LoginResponse&gt;<BR/>+ cadastrar(req: CadastroRequest): ResponseEntity&lt;UsuarioResponse&gt;<BR/>+ usuarioAtual(u: UsuarioAutenticado): UsuarioResponse<BR/>+ csrf(token: CsrfToken): CsrfResponse<BR/>- registrarAutenticacao(...)  {troca o id da sessão}</TD></TR></TABLE>>];
  LimitadorTentativasLogin [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@Component»</FONT><BR/><B>LimitadorTentativasLogin</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- tentativasPorIp: Map  {máx. 20}<BR/>- tentativasPorEmail: Map  {máx. 5}<BR/>  janela de 1 minuto</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ verificarIp(ip) / verificarEmail(email):<BR/>    Optional&lt;Duration&gt;<BR/>+ registrarFalhaIp(ip) / registrarFalhaEmail(email)<BR/>+ registrarSucessoEmail(email)</TD></TR></TABLE>>];
  AuthExceptionHandler [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@RestControllerAdvice»</FONT><BR/><B>AuthExceptionHandler</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ entradaInvalida()  [400]<BR/>+ emailJaCadastrado()  [409]<BR/>+ erroInterno(e)  [500]</TD></TR></TABLE>>];
  Dtos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>Objetos de transferência</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">LoginRequest (email, senha)<BR/>CadastroRequest (nome, email, senha)<BR/>LoginResponse (autenticado, usuario, erro, mensagem)<BR/>UsuarioResponse (id, nome, email)<BR/>ErroResponse (erro, mensagem)<BR/>CsrfResponse (headerName, token)</TD></TR></TABLE>>];
    { rank=same; AuthExceptionHandler; AuthController; LimitadorTentativasLogin; }
  }
  subgraph cluster_cfg {
    label=<<I>config</I>>; labeljust=l; style="rounded,filled"; fillcolor="#F1F8E9"; color="#66BB6A"; penwidth=1.3;
  SecurityConfig [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@Configuration» «@EnableWebSecurity»</FONT><BR/><B>SecurityConfig</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ securityFilterChain(http): SecurityFilterChain<BR/>  {CSRF na sessão, X-XSRF-TOKEN, regras de acesso,<BR/>   logout em /api/auth/logout, 401/403 em JSON}<BR/>+ securityContextRepository(): HttpSession…</TD></TR></TABLE>>];
  AutenticacaoConfig [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@Configuration»</FONT><BR/><B>AutenticacaoConfig</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ authService(r, h): AuthService  «@Bean»<BR/>+ clock(): Clock  «@Bean»</TD></TR></TABLE>>];
  CorsConfig [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@Configuration»</FONT><BR/><B>CorsConfig</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ addCorsMappings(reg): void<BR/>  /api/** · GET, POST, OPTIONS · credenciais</TD></TR></TABLE>>];
  UsuarioAutenticado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«record» Serializable</FONT><BR/><B>UsuarioAutenticado</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ id: UUID<BR/>+ nome: String<BR/>+ email: String</TD></TR></TABLE>>];
  }
  subgraph cluster_dom {
    label=<<I>domain</I> — negócio>; labeljust=l; style="rounded,filled"; fillcolor="#FFFFFF"; color="#66BB6A"; penwidth=1.3;
  AuthService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFDE7" COLOR="#37474F"><TR><TD><B>AuthService</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- userRepository: UserRepository<BR/>- passwordHasher: PasswordHasher<BR/>- hashFicticio: String  {readOnly}</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ autenticar(email, senha): ResultadoAutenticacao<BR/>+ cadastrar(nome, email, senha): IdentidadeUsuario</TD></TR></TABLE>>];
  UserRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><B><I>UserRepository</I></B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ buscarPorEmail(email): Optional&lt;Usuario&gt;<BR/>+ existePorEmail(email): boolean<BR/>+ salvar(nome, email, senhaHash): Usuario</TD></TR></TABLE>>];
  PasswordHasher [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><B><I>PasswordHasher</I></B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ verificar(senha, hashArmazenado): boolean<BR/>+ gerarHash(senha): String</TD></TR></TABLE>>];
  DomRecords [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«record» / exceção</FONT><BR/><B>Dados do domínio</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">ResultadoAutenticacao (autenticado, identidade)<BR/>IdentidadeUsuario (id, nome, email)<BR/>Usuario (id, nome, email, senhaHash)<BR/>EmailJaCadastradoException</TD></TR></TABLE>>];
    { rank=same; UserRepository; AuthService; PasswordHasher; }
  }
  subgraph cluster_inf {
    label=<<I>infra</I> — persistência e criptografia>; labeljust=l; style="rounded,filled"; fillcolor="#F1F8E9"; color="#66BB6A"; penwidth=1.3;
  JpaUserRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@Repository»</FONT><BR/><B>JpaUserRepository</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- usuarioJpaRepository: UsuarioJpaRepository</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ buscarPorEmail, existePorEmail<BR/>+ salvar(...)  {unicidade violada → EmailJaCadastradoException}</TD></TR></TABLE>>];
  UsuarioJpaRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«interface» JpaRepository&lt;UsuarioEntity, UUID&gt;</FONT><BR/><B><I>UsuarioJpaRepository</I></B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ findByEmail(email): Optional&lt;UsuarioEntity&gt;<BR/>+ existsByEmail(email): boolean</TD></TR></TABLE>>];
  UsuarioEntity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@Entity» tabela usuarios</FONT><BR/><B>UsuarioEntity</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- id: UUID  {@Id @GeneratedValue(UUID)}<BR/>- nome  {120} · email  {único, 254}<BR/>- senhaHash  {255}</TD></TR></TABLE>>];
  Argon2PasswordHasher [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF" COLOR="#37474F"><TR><TD><FONT POINT-SIZE="8">«@Component»</FONT><BR/><B>Argon2PasswordHasher</B></TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">- encoder: Argon2PasswordEncoder<BR/>  {sal 16 B, hash 32 B, p=1, m=19456 KiB, t=2}</TD></TR><TR><TD SIDES="T" BORDER="1" ALIGN="LEFT" BALIGN="LEFT">+ verificar(senha, hash): boolean<BR/>+ gerarHash(senha): String</TD></TR></TABLE>>];
    { rank=same; JpaUserRepository; Argon2PasswordHasher; }
  }
  }

  LoginComponent -> FrontAuthService [style=dashed, arrowhead=vee];
  SignUpComponent -> FrontAuthService [style=dashed, arrowhead=vee];
  ProfileComponent -> FrontAuthService [style=dashed, arrowhead=vee];
  Guards -> FrontAuthService [style=dashed, arrowhead=vee, label=" isAuthenticated()"];
  FrontAuthService -> AuthController [style=dashed, arrowhead=vee, color="#1565C0", label=<  HTTP via proxy<BR/>  /api/auth/*>];
  AuthController -> LimitadorTentativasLogin [arrowhead=vee, label=" usa", constraint=false];
  AuthController -> Dtos [style=dashed, arrowhead=vee, label=" recebe e produz"];
  AuthExceptionHandler -> Dtos [style=dashed, arrowhead=vee, label=" produz"];
  AuthController -> AuthService [arrowhead=vee, label=" delega"];
  AuthController -> UsuarioAutenticado [style=dashed, arrowhead=vee, label=" guarda na sessão"];
  AutenticacaoConfig -> AuthService [style=dashed, arrowhead=vee, label=" «create»"];
  AuthService -> UserRepository [arrowhead=vee, constraint=false];
  AuthService -> PasswordHasher [arrowhead=vee, constraint=false];
  AuthService -> DomRecords [style=dashed, arrowhead=vee, label=" produz"];
  UserRepository -> JpaUserRepository [style=dashed, dir=back, arrowtail=onormal];
  PasswordHasher -> Argon2PasswordHasher [style=dashed, dir=back, arrowtail=onormal];
  JpaUserRepository -> UsuarioJpaRepository [arrowhead=vee, label=" usa"];
  UsuarioJpaRepository -> UsuarioEntity [style=dashed, arrowhead=vee];
  SecurityConfig -> AutenticacaoConfig [style=invis];
  AutenticacaoConfig -> CorsConfig [style=invis];
  CorsConfig -> UsuarioAutenticado [style=invis];
  Dtos -> UserRepository [style=invis];
  DomRecords -> JpaUserRepository [style=invis];
  FrontAuthService -> SecurityConfig [style=invis];
}
